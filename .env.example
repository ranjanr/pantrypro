# ===================================================
# PantryPro Environment Configuration Template
# ===================================================

# 1. MongoDB Atlas Connection String
# Get your connection string from MongoDB Atlas: Clusters -> Connect -> Drivers -> Node.js
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.yourdomain.mongodb.net/?retryWrites=true&w=majority

# Name of the database (default: pantrypro)
MONGODB_DB_NAME=pantrypro

# 2. Google Gemini API Key
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
# Used for:
# - Dynamic Pro Chef persona rewriting (gemini-2.5-pro / flash)
# - Intelligent Pantry Recipe Synthesis
# - Vector embeddings (text-embedding-004)
# - Interactive Sous Chef Assistant
GEMINI_API_KEY=your_google_gemini_api_key_here

# 3. Next.js Runtime Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
